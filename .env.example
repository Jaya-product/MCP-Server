# ==============================================================================
# Google Cloud OAuth 2.0 Credentials
# Obtain these from: https://console.cloud.google.com/apis/credentials
# ==============================================================================
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret-here
GOOGLE_REDIRECT_URI=http://localhost:3000/oauth2callback

# Path to store authorized user refresh tokens (kept secure with 0600 permissions)
TOKEN_STORAGE_PATH=./.credentials/tokens.json

# Optional: Seed initial tokens from environment variable (useful on cloud hosts like Railway)
# GOOGLE_TOKENS_JSON={"access_token":"...","refresh_token":"..."}
# INITIAL_TOKENS_BASE64=eyJhbGciOi...

# ==============================================================================
# MCP Protocol & Transport Configuration
# Options: stdio (for local agent like Claude Desktop/Cursor) | streamable-http (for remote)
# Note: On Railway, MCP_PORT defaults automatically to $PORT, and MCP_HOST defaults to 0.0.0.0
# ==============================================================================
MCP_TRANSPORT=stdio
MCP_HOST=127.0.0.1
MCP_PORT=8080
# Optional API key for remote HTTP clients (must be passed via Authorization: Bearer <KEY> or ?apiKey=<KEY>)
# MCP_API_KEY=your-secure-mcp-api-key

# ==============================================================================
# Safety Guardrails & Operational Limits
# ==============================================================================
# When true, emails will not be sent unless the model explicitly passes confirm_send: true
REQUIRE_EMAIL_CONFIRMATION=true

# Safety caps on request sizes
MAX_EMAIL_RECIPIENTS=50
MAX_EMAIL_BODY_BYTES=1048576
MAX_DOC_APPEND_BYTES=524288

# Logging level: debug | info | warn | error (all logs write to stderr only)
LOG_LEVEL=info
